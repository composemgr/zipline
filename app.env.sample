# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=zipline.example.com

APP_ORG_NAME=Zipline

DB_USER_NAME=zipline
DB_USER_PASS=replace-with-a-random-password
DB_CREATE_DATABASE_NAME=zipline

# Encryption key for sessions and share links (min 32 characters)
APP_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# First user created on an empty database
APP_ADMIN_USER=admin
APP_ADMIN_PASS=replace-with-a-random-password
ZIPLINE_CREATE_USER=true

# Set to true behind a reverse proxy so share links stay relative
ZIPLINE_RETURN_RELATIVE_URLS=false
ZIPLINE_TRUSTED_PROXIES=0.0.0.0/0,::/0
